# Reference only: Spring does not load this file automatically.
# Merge selected entries into the existing /srv/gongbang/deploy/backend.env.
# Do not replace that file: preserve DB, JWT, crawler and sync settings.
# Fill credentials on the server. Never commit the completed file.

FRONT_BASE_URL=https://gongbang.apple-farm.online
OAUTH_REDIRECT_URI_TEMPLATE=https://gongbang.apple-farm.online/login/oauth2/code/{registrationId}

# Kakao console callback:
# https://gongbang.apple-farm.online/login/oauth2/code/kakao
# KAKAO_CLIENT_ID is the REST API key, not the JavaScript or admin key.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# Enable account_email only after the app has permission to request it.
KAKAO_SCOPE=

# Google OAuth web client callback:
# https://gongbang.apple-farm.online/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# These are the SENDER account settings, not the user's login/recipient email.
# Use the host, port and credentials issued by the SMTP provider.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_DEV_CODE=false
