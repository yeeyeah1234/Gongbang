# MY-01: merge into the server's existing backend.env; do not replace it.
# Local default: PROFILE_STORAGE=local (UPLOAD_DIR remains supported).
PROFILE_STORAGE=s3
S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=garage
S3_PUBLIC_BUCKET=gongbang-public
FILE_PUBLIC_BASE_URL=https://gongbang.apple-farm.online/files
# Preserve the existing S3_ACCESS_KEY and S3_SECRET_KEY on the server.
# This feature does not access S3_PRIVATE_BUCKET or uploaded_file.
# DB keeps profile_image_url; no schema migration is required.
# Existing /uploads URLs are not migrated. Re-upload the profile photo,
# or migrate old files separately before removing the local upload directory.
# Old remote files are deleted after DB commit; failed cleanup is logged.
# When changing FILE_PUBLIC_BASE_URL, migrate existing DB URLs separately.
# Deploy backend and restart it, then upload a PNG/JPEG and verify the returned
# /files/profile/... URL responds with image/png or image/jpeg (not HTML).
# Test Garage credentials and /files proxy on the server before release.
